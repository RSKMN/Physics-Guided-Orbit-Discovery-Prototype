{
    "simulation_name": "synthetic_asteroid",
    "initial_conditions": {
        "mode": "orbital_elements",
        "semi_major_axis_au": 2.5,
        "eccentricity": 0.2,
        "inclination_deg": 0.0,
        "longitude_ascending_node_deg": 0.0,
        "argument_periapsis_deg": 0.0,
        "mean_anomaly_deg": 0.0
