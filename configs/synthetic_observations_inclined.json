
{
    "observation_name": "synthetic_asteroid_inclined_observations",

    "input_trajectory": "data/runs/synthetic_asteroid_inclined/trajectory.csv",

    "observer": {
        "model": "idealized_circular",
        "orbital_radius_au": 1.0,
        "orbital_period_years": 1.0,
        "initial_phase_deg": 90.0
    },

    "coordinates": {
        "input_frame": "heliocentric_ecliptic",
        "output_frame": "equatorial",
        "obliquity_deg": 23.43928,
        "ra_unit": "degrees",
        "dec_unit": "degrees"
    },

    "observation_schedule": {
        "cadence_days": 7.0,
        "start_day": 0.0,
        "end_day": 1826.25
    },

    "measurement_noise": {
        "model": "gaussian",
        "sigma_ra_cosdec_arcsec": 0.5,
        "sigma_dec_arcsec": 0.5,
        "random_seed": 42
    },

    "output": {
        "directory": "data/observations",
        "save_noise_free_coordinates": true,
        "save_metadata": true
    }
}

